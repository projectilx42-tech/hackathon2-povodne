{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/install-rtk.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-uncommitted.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/rtk-hook.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./docs/source/**)",
      "Read(./dashboard/static/vendor/**)",
      "Read(./training/himalaya/quicklooks/**)",
      "Read(./dashboard/sample_run/overlays/**)",
      "Read(./data/**)",
      "Read(./runs/**)",
      "Read(./models/**)"
    ]
  }
}
